{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nginx Values",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "default": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "default": "nginx"
        },
        "pullPolicy": {
          "type": "string",
          "default": "IfNotPresent"
        },
        "tag": {
          "type": "string",
          "default": "stable"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": "string",
          "default": "ClusterIP"
        },
        "port": {
          "type": "integer",
          "default": 80
        }
      }
    }
  }
}
